{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Library System Schemas",
  "type": "object",
  "properties": {
    "Book": {
      "type": "object",
      "required": ["id", "title", "isbn", "stock"],
      "properties": {
        "id": { "type": "string", "pattern": "^book_[a-zA-Z0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "isbn": { "type": "string", "pattern": "^\\d{10}|\\d{13}$" },
        "stock": { "type": "integer", "minimum": 0 },
        "categoryId": { "type": "string" }
      }
    },
    "Reader": {
      "type": "object",
      "required": ["id", "name", "email"],
      "properties": {
        "id": { "type": "string", "pattern": "^reader_[a-zA-Z0-9]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "pattern": "^0\\d{9}$" },
        "isActive": { "type": "boolean", "default": true }
      }
    },
    "Loan": {
      "type": "object",
      "required": ["id", "readerId", "borrowDate", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^loan_[a-zA-Z0-9]+$" },
        "readerId": { "type": "string" },
        "borrowDate": { "type": "string", "format": "date-time" },
        "dueDate": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "enum": ["active", "returned", "overdue"]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["bookId"],
            "properties": {
              "bookId": { "type": "string" },
              "conditionOut": { "type": "string" }
            }
          }
        }
      }
    }
  }
}